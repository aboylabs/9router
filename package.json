{
  "name": "9router",
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "start": "node dist/server/index.js",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"vite build --config vite.config.ts --watch\" \"node --watch dist/server/index.js\""
  },
